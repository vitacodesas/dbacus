{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git * push:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh release:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh secret:*)",
      "Bash(npm publish:*)",
      "Bash(docker push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-publish.sh",
            "onFailure": "block",
            "statusMessage": "Comprobando que no se publique nada..."
          }
        ]
      }
    ]
  }
}
