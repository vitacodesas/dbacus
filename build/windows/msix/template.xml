<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="dbacus"
        Arguments=""
        InstallLocation="C:\Program Files\Laika\Dbacus">
    </Installer>
    <PackageInformation
        PackageName="Dbacus"
        PackageDisplayName="Dbacus"
        PublisherName="CN=Laika"
        PublisherDisplayName="Laika"
        Version="0.1.0.0"
        PackageDescription="Cliente SQL de escritorio">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.vitacodesas.dbacus"
                Description="Cliente SQL de escritorio"
                DisplayName="Dbacus"
                ExecutableName="dbacus"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Dbacus</DisplayName>
            <PublisherDisplayName>Laika</PublisherDisplayName>
            <Description>Cliente SQL de escritorio</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="dbacus.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
