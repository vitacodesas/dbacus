{
  "name": "tabularis-clon-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "vue-tsc --noEmit && vite build --minify false --mode development",
    "build": "vue-tsc --noEmit && vite build --mode production",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@wailsio/runtime": "3.0.0",
    "lucide-vue-next": "^1.0.0",
    "monaco-editor": "0.56.0",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.2.45",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.2.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.12"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
